# Optional shared runtime configuration.  Export these variables (or source
# this file) before starting the project processes.

MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_PORT=8554
MEDIAMTX_PATH=live
RGBDSORT_RTSP_URL=rtsp://127.0.0.1:8554/live
RGBDSORT_VIDEO_URL=0
RGBDSORT_OUTPUT_DIR=
RGBDSORT_FRAME_DIR=
RGBDSORT_VIDEO_DIR=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=laboratory
MYSQL_CAMERA_ID=1
MYSQL_LOCATION_ID=1

ADAFACE_RECEIVED_PATH=
ADAFACE_INDOOR_OUTPUT_PATH=
ADAFACE_LOADED_FACES_PATH=
ADAFACE_NEW_FACES_PATH=
ADAFACE_DEVICE=cuda:0
ADAFACE_MODEL_PATH=
ADAFACE_LANDMARK_MODEL_PATH=
DSLFIQA_CONFIG_PATH=
DSLFIQA_DE_PATH=
DSLFIQA_IQA_PATH=
ADAFACE_DB_HOST=localhost
ADAFACE_DB_USER=
ADAFACE_DB_PASSWORD=
ADAFACE_DB_NAME=laboratory
ADAFACE_REDIS_HOST=localhost
ADAFACE_REDIS_PORT=6379
ADAFACE_REDIS_DB=0
ADAFACE_REDIS_QUEUE=adaface_master
ADAFACE_FAY_URL=

# Select separate Python/Conda environments when RGBDSort and AdaFace use
# different Torch versions.
RGB_PYTHON_BIN=python
ADAFACE_PYTHON_BIN=python
# Optional external MediaMTX process started by legacy/depth.sh.
MEDIAMTX_DIR=
MEDIAMTX_BIN=mediamtx
