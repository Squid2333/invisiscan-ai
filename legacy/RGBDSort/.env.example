# MediaMTX / camera
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_PORT=8554
MEDIAMTX_PATH=live
RGBDSORT_VIDEO_URL=0
RGBDSORT_ROTATE_CCW_90=1
RGBDSORT_RTSP_URL=rtsp://127.0.0.1:8554/live

# Runtime paths (defaults are under legacy/RGBDSort/runtime)
# RGBDSORT_OUTPUT_DIR=/path/to/runtime/output
# RGBDSORT_FRAME_DIR=/path/to/runtime/frames
# RGBDSORT_VIDEO_DIR=/path/to/runtime/videos
RGBDSORT_OCR_DEBUG_DIR=/tmp/rgbsort_ocr_debug

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional MySQL integration.  Leave MYSQL_USER empty to disable writes when
# the mysql client is unavailable; set all values in a deployment environment.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=laboratory
MYSQL_CAMERA_ID=1
MYSQL_LOCATION_ID=1

# Inference devices (use cpu on machines without CUDA)
RGBDSORT_LSTM_DEVICE=cuda
RGBDSORT_MTCNN_DEVICE=cuda:0
